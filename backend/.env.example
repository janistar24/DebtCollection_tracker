POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_SSL=true

AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:8443

DB_POOL_MAX=8
DB_POOL_TIMEOUT=15
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000
# ค่า 0 เหมาะกับ Railway: สร้าง connection เมื่อมี request และตรวจ reconnect ก่อนใช้
DB_POOL_MIN=0
LOG_LEVEL=INFO
ENVIRONMENT=development

# URL หน้าเว็บ Frontend ที่ผู้รับคำเชิญเปิดได้ เช่น https://example.up.railway.app
FRONTEND_URL=http://localhost:8443
INVITATION_EXPIRES_HOURS=48
